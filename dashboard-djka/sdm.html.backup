            </thead>
            <tbody>
              <tr><td class="no">1</td><td>Balai Pengujian Perkeretaapian</td><td class="center"><div class="toggle-wrap"><label class="toggle"><input type="checkbox" checked><div class="toggle-track"></div><div class="toggle-thumb"></div></label></div></td><td class="center"><div class="action-cell"><button class="btn-act btn-act-edit" aria-label="Edit unit kerja"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div></td></tr>
              <tr><td class="no">2</td><td>Subbagian Keuangan dan Tata Usaha</td><td class="center"><div class="toggle-wrap"><label class="toggle"><input type="checkbox" checked><div class="toggle-track"></div><div class="toggle-thumb"></div></label></div></td><td class="center"><div class="action-cell"><button class="btn-act btn-act-edit" aria-label="Edit unit kerja"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div></td></tr>
              <tr><td class="no">3</td><td>Seksi Pengujian Prasarana Perkeretaapian</td><td class="center"><div class="toggle-wrap"><label class="toggle"><input type="checkbox" checked><div class="toggle-track"></div><div class="toggle-thumb"></div></label></div></td><td class="center"><div class="action-cell"><button class="btn-act btn-act-edit" aria-label="Edit unit kerja"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div></td></tr>
              <tr><td class="no">4</td><td>Seksi Pengujian Sarana Perkeretaapian</td><td class="center"><div class="toggle-wrap"><label class="toggle"><input type="checkbox" checked><div class="toggle-track"></div><div class="toggle-thumb"></div></label></div></td><td class="center"><div class="action-cell"><button class="btn-act btn-act-edit" aria-label="Edit unit kerja"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div></td></tr>
              <tr><td class="no">5</td><td>Seksi Pengujian SDM Perkeretaapian</td><td class="center"><div class="toggle-wrap"><label class="toggle"><input type="checkbox" checked><div class="toggle-track"></div><div class="toggle-thumb"></div></label></div></td><td class="center"><div class="action-cell"><button class="btn-act btn-act-edit" aria-label="Edit unit kerja"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div></td></tr>
            </tbody>
