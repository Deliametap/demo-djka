            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">510807XXXXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="edit-peg-nip">NIP <span class="req">*</span></label>
            <input class="form-input" id="edit-peg-nip" type="text" inputmode="numeric" placeholder="Isi NIP..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">510807XXXXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
