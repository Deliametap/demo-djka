            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value">Pilih status pegawai...</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
