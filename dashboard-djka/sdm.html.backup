        <!-- Foto Pegawai -->
        <div class="form-group">
          <label class="form-label">Foto Pegawai</label>
          <input type="file" id="edit-peg-foto-input" accept=".jpg,.jpeg,.png" style="display:none;">
          <div class="file-upload-zone" id="editPegFotoZone" onclick="document.getElementById('edit-peg-foto-input').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            <span class="file-upload-text">Drag & drop file atau klik disini</span>
            <span class="file-upload-sub" id="editPegFotoName">Belum ada file dipilih</span>
          </div>
          <div class="form-hint" style="margin-top:2px;">
            <div class="form-hint-row">*) Maksimal: <span class="form-hint-code amber">2MB</span> — Format: <span class="form-hint-code">*.jpg</span> <span class="form-hint-code">*.jpeg</span> <span class="form-hint-code">*.png</span></div>
          </div>
        </div>

      </div><!-- /.modal-body -->

      <div class="modal-footer">
        <button class="btn-modal-danger" id="modal-edit-peg-hapus">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          Hapus Pegawai
        </button>
        <button class="btn-modal-ghost" id="modal-edit-peg-batal">Batal</button>
        <button class="btn-modal-primary" id="modal-edit-peg-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <script>

    /* ── Update Date in Topbar ── */
    function updateCurrentDate() {
      const dateElement = document.getElementById('currentDate');
      if (dateElement) {
        const now = new Date();
        const bulanIndo = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const hari = now.getDate();
        const bulan = bulanIndo[now.getMonth()];
        const tahun = now.getFullYear();
        dateElement.textContent = `${hari} ${bulan} ${tahun}`;
      }
    }
    updateCurrentDate();

    /* ── Sub-nav Panel Toggle ── */
    const subnavPanel = document.getElementById('subnavPanel');
    const subnavCollapse = document.getElementById('subnavCollapse');
    if (subnavCollapse) {
      subnavCollapse.addEventListener('click', function() {
        subnavPanel.classList.toggle('open');
      });
    }

    /* ── Update topbar module icon ── */
    function updateTopbarIcon(navItem) {
      const svgSrc = navItem.querySelector('.nav-icon-box svg');
      const topbarSvg = document.getElementById('topbarModuleSvg');
      if (svgSrc && topbarSvg) {
        topbarSvg.innerHTML = svgSrc.innerHTML;
        topbarSvg.setAttribute('viewBox', svgSrc.getAttribute('viewBox') || '0 0 24 24');
      }
    }

    /* ── Mark active nav item from data-active-nav ── */
    const activeNav = document.body.dataset.activeNav;
    document.querySelectorAll('.nav-item').forEach(item => {
      const label = item.querySelector('.nav-item-label')?.textContent?.trim()
                 || item.getAttribute('aria-label') || '';
      if (label === activeNav) {
        item.classList.add('active');
        item.setAttribute('aria-current', 'page');
        updateTopbarIcon(item);
      }
    });

    /* ── Open subnav if this page has one ── */
    const subnavMap = {
      'SDM':              'subnav-sdm',
      'Masterisasi':      'subnav-masterisasi',
      'Akses SSO':        'subnav-akses-sso',
      'Pengelola Portal': 'subnav-pengelola-portal',
    };
    if (subnavMap[activeNav]) {
      const sec = document.getElementById(subnavMap[activeNav]);
      if (sec) { sec.classList.add('active'); subnavPanel.classList.add('open'); }
    }

    /* ── Sidebar nav clicks → navigate to module file ── */
    const navRoutes = {
      'Dashboard':        'index.html',
      'SDM':              'sdm.html',
      'Masterisasi':      'masterisasi.html',
      'Akses SSO':        'akses-sso.html',
      'Pengelola Portal': 'pengelola-portal.html',
      'Manajemen Portal': 'manajemen-portal.html',
      'API':              '#',
      'Data SIK':         'data-sik.html',
    };
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        const label = this.querySelector('.nav-item-label')?.textContent?.trim()
                   || this.getAttribute('aria-label') || '';
        const route = navRoutes[label];
        if (route && route !== '#') window.location.href = route;
      });
    });
  </script>

  <script>
    function showSDMPage(pageKey) {
      document.querySelectorAll('#subnav-sdm .subnav-item').forEach(t => {
        t.classList.toggle('active', t.dataset.page === pageKey);
      });
      document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
      const target = document.getElementById('view-' + pageKey);
      if (target) target.classList.add('active');
    }
    document.querySelectorAll('#subnav-sdm .subnav-item').forEach(item => {
      item.addEventListener('click', function() { showSDMPage(this.dataset.page); });
    });
  </script>

  <script>
    // ── Modal helpers ──────────────────────────────────────────
    function openModal(id) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.classList.add('open');
      const firstInput = overlay.querySelector('.form-input');
      if (firstInput) setTimeout(() => firstInput.focus(), 50);
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('open');
    }

    // Close on overlay click
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', function(e) {
        if (e.target === this) closeModal(this.id);
      });
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.open').forEach(o => o.classList.remove('open'));
      }
    });

    document.getElementById('modal-detail-uk-close').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-batal').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-hapus').addEventListener('click', () => closeModal('modal-detail-uk'));

    // ── Custom Dropdown factory ────────────────────────────────
    function initCdd(cddEl) {
      const trigger = cddEl.querySelector('.cdd-trigger');
      const menu    = cddEl.querySelector('.cdd-menu');
      const valueEl = cddEl.querySelector('.cdd-value');
      const items   = cddEl.querySelectorAll('.cdd-item');
      let selected  = '';

      function open()  { trigger.classList.add('open'); menu.classList.add('open'); trigger.setAttribute('aria-expanded','true'); }
      function close() { trigger.classList.remove('open'); menu.classList.remove('open'); trigger.setAttribute('aria-expanded','false'); }
      function toggle(){ trigger.classList.contains('open') ? close() : open(); }

      trigger.addEventListener('click', e => { e.stopPropagation(); toggle(); });

      const placeholder = items[0] ? items[0].textContent.trim() : valueEl.textContent.trim();

      items.forEach(item => {
        item.addEventListener('click', () => {
          selected = item.dataset.value;
          items.forEach(i => i.classList.remove('selected'));
          item.classList.add('selected');
          valueEl.textContent = selected ? item.textContent.trim() : placeholder;
          valueEl.classList.toggle('selected', !!selected);
          close();
          cddEl.dispatchEvent(new CustomEvent('cdd:change', { detail: { value: selected } }));
        });
      });

      document.addEventListener('click', e => { if (!cddEl.contains(e.target)) close(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

      return { reset() { selected=''; items.forEach(i=>i.classList.remove('selected')); if(items[0])items[0].classList.add('selected'); valueEl.textContent=placeholder; valueEl.classList.remove('selected'); } };
    }

  </script>
  <script>

    // ── Tambah Unit Kerja ──────────────────────────────────────
    const btnTambahUK = document.querySelector('#view-unit-kerja .btn-tambah');
    if (btnTambahUK) {
      btnTambahUK.addEventListener('click', function() {
        document.getElementById('input-nama-uk').value = '';
        openModal('modal-tambah-uk');
      });
    }
    document.getElementById('modal-tambah-uk-close').addEventListener('click', () => closeModal('modal-tambah-uk'));
    document.getElementById('modal-tambah-uk-batal').addEventListener('click', () => closeModal('modal-tambah-uk'));

    // ── Detail Unit Kerja ──────────────────────────────────────
    document.querySelectorAll('#view-unit-kerja .btn-detail').forEach(btn => {
      btn.addEventListener('click', function() {
        const row = this.closest('tr');
        const nama = row ? row.cells[1].textContent.trim() : '';
        document.getElementById('edit-nama-uk').value = nama;
        openModal('modal-detail-uk');
      });
    });
    document.getElementById('modal-detail-uk-close').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-batal').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-hapus').addEventListener('click', () => closeModal('modal-detail-uk'));

      document.getElementById('btnResetFilterPegawai').addEventListener('click', () => cddPeg.reset());
      document.getElementById('btnApplyFilterPegawai').addEventListener('click', function() {
        filterPopover.classList.remove('open');
        btnFilterPeg.classList.remove('active');
        btnFilterPeg.setAttribute('aria-expanded', 'false');
      });

    // ── Tambah Jabatan ─────────────────────────────────────────
    const btnTambahJab = document.querySelector('#view-jabatan .btn-tambah');
    if (btnTambahJab) {
      btnTambahJab.addEventListener('click', function() {
        document.getElementById('input-nama-jab').value = '';
        openModal('modal-tambah-jab');
      });
    }
    document.getElementById('modal-tambah-jab-close').addEventListener('click', () => closeModal('modal-tambah-jab'));
    document.getElementById('modal-tambah-jab-batal').addEventListener('click', () => closeModal('modal-tambah-jab'));

    // ── Detail Jabatan ─────────────────────────────────────────
    document.querySelectorAll('#view-jabatan .btn-detail').forEach(btn => {
      btn.addEventListener('click', function() {
        const row = this.closest('tr');
        const nama = row ? row.cells[1].textContent.trim() : '';
        document.getElementById('edit-nama-jab').value = nama;
        openModal('modal-detail-jab');
      });
    });
    document.getElementById('modal-detail-jab-close').addEventListener('click', () => closeModal('modal-detail-jab'));
    document.getElementById('modal-detail-jab-batal').addEventListener('click', () => closeModal('modal-detail-jab'));
    document.getElementById('modal-detail-jab-hapus').addEventListener('click', () => closeModal('modal-detail-jab'));

    // ── Filter popover toggle (Data Pegawai) ──────────────────
    const btnFilterPeg   = document.getElementById('btnFilterPegawai');
    const filterPopover  = document.getElementById('filterPopover');
    const cddPeg = initCdd(document.getElementById('cddStatusPegawai'));

    if (btnFilterPeg && filterPopover) {
      btnFilterPeg.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = filterPopover.classList.toggle('open');
        this.classList.toggle('active', isOpen);
        this.setAttribute('aria-expanded', isOpen);
      });
      document.addEventListener('click', function(e) {
        const wrap = document.getElementById('filterPopoverWrap');
        if (wrap && !wrap.contains(e.target)) {
          filterPopover.classList.remove('open');
          btnFilterPeg.classList.remove('active');
          btnFilterPeg.setAttribute('aria-expanded', 'false');
        }
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && filterPopover.classList.contains('open')) {
          filterPopover.classList.remove('open');
          btnFilterPeg.classList.remove('active');
          btnFilterPeg.setAttribute('aria-expanded', 'false');
          btnFilterPeg.focus();
        }
      });
      document.getElementById('btnResetFilterPegawai').addEventListener('click', () => cddPeg.reset());
      document.getElementById('btnApplyFilterPegawai').addEventListener('click', function() {
        filterPopover.classList.remove('open');
        btnFilterPeg.classList.remove('active');
        btnFilterPeg.setAttribute('aria-expanded', 'false');
      });
    }

    // ── Tambah Pegawai ─────────────────────────────────────────
    const btnTambahPeg = document.querySelector('#view-data-pegawai .btn-tambah');
    if (btnTambahPeg) {
      btnTambahPeg.addEventListener('click', function() {
        // Reset all fields
        ['peg-sub-kantor','peg-jabfung','peg-nik','peg-nip','peg-nama',
         'peg-tempat-lahir','peg-tgl-lahir','peg-alamat','peg-email','peg-telp']
          .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
        document.getElementById('pegFotoName').textContent = 'Belum ada file dipilih';
        openModal('modal-tambah-peg');
      });
    }
    document.getElementById('modal-tambah-peg-close').addEventListener('click', () => closeModal('modal-tambah-peg'));
    document.getElementById('modal-tambah-peg-batal').addEventListener('click', () => closeModal('modal-tambah-peg'));
    document.getElementById('modal-tambah-peg-simpan').addEventListener('click', () => closeModal('modal-tambah-peg'));

    // Init CDDs inside Tambah Pegawai modal
    initCdd(document.getElementById('cddUnitKerjaPeg'));
    initCdd(document.getElementById('cddJabatanPeg'));
    initCdd(document.getElementById('cddStatusPegTambah'));

    // File upload zone
    const fotoInput = document.getElementById('peg-foto-input');
    const fotoZone  = document.getElementById('pegFotoZone');
    const fotoName  = document.getElementById('pegFotoName');
    if (fotoInput && fotoZone) {
      fotoInput.addEventListener('change', function() {
        fotoName.textContent = this.files[0] ? this.files[0].name : 'Belum ada file dipilih';
      });
      fotoZone.addEventListener('dragover', e => { e.preventDefault(); fotoZone.classList.add('drag-over'); });
      fotoZone.addEventListener('dragleave', () => fotoZone.classList.remove('drag-over'));
      fotoZone.addEventListener('drop', e => {
        e.preventDefault(); fotoZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) { fotoInput.files = e.dataTransfer.files; fotoName.textContent = file.name; }
      });
    }

    // ── Edit Pegawai ───────────────────────────────────────────
    // Data dummy per baris — key = nomor baris (1-based)
    const pegawaiData = {
      1: {
        unitKerja: 'bpp', unitKerjaLabel: 'Balai Pengujian Perkeretaapian',
        subKantor: 'Unit Pengembangan Usaha dan Kerja Sama',
        jabatan: 'staff', jabatanLabel: 'Staff',
        jabfung: 'Pengelola IT',
        status: 'P3K',
        nik: '6201012909950001', nip: '0',
        nama: 'Balai Dev Apps',
        tempatLahir: 'Balikpapan', tglLahir: '29/09/1995',
        alamat: '-',
        email: 'balaidev@gmail.com', telp: '0'
      },
      2: {
        unitKerja: 'bpp', unitKerjaLabel: 'Direktorat Jenderal Perkeretaapian',
        subKantor: 'Unit Pengembangan Usaha dan Kerja Sama',
        jabatan: 'staff', jabatanLabel: 'Staff',
        jabfung: 'Pengevaluasi Program dan Kegiatan',
        status: 'ASN',
        nik: '3275051311840014', nip: '198411132008121003',
        nama: 'Sigit Sukmoro, S.Kom',
        tempatLahir: 'Jakarta', tglLahir: '13/11/1984',
        alamat: '-',
        email: 'sigit_sukmoro@dephub.go.id', telp: '0'
      },
      3: {
        unitKerja: 'ssa', unitKerjaLabel: 'Seksi Pengujian Sarana Perkeretaapian',
        subKantor: 'Seksi Pengujian Sarana',
        jabatan: 'kassa', jabatanLabel: 'Kepala Seksi Pengujian Sarana',
        jabfung: 'Penguji Sarana Perkeretaapian',
        status: 'ASN',
        nik: '3276020303790009', nip: '197903032006041006',
        nama: 'Ronald Jackson Simbolon, ST, MT',
        tempatLahir: 'Jakarta', tglLahir: '03/03/1979',
        alamat: '-',
        email: 'ronald_jackson@kemenhub.go.id', telp: '0'
      }
    };

    function setCddValue(cddEl, value, label) {
      if (!cddEl) return;
      const trigger = cddEl.querySelector('.cdd-trigger');
      const valueEl = cddEl.querySelector('.cdd-value');
      const items   = cddEl.querySelectorAll('.cdd-item');
      if (valueEl) { valueEl.textContent = label; valueEl.classList.add('selected'); }
      if (trigger) trigger.dataset.selected = value;
      items.forEach(item => item.classList.toggle('selected', item.dataset.value === value));
    }

    function openEditPegawai(rowIndex) {
      const d = pegawaiData[rowIndex];
      if (!d) return;

      // Populate dropdowns
      setCddValue(document.getElementById('cddUnitKerjaEdit'), d.unitKerja, d.unitKerjaLabel);
      setCddValue(document.getElementById('cddJabatanEdit'),   d.jabatan,   d.jabatanLabel);
      setCddValue(document.getElementById('cddStatusPegEdit'), d.status,    d.status);

      // Populate text inputs
      const fields = {
        'edit-peg-sub-kantor':   d.subKantor,
        'edit-peg-jabfung':      d.jabfung,
        'edit-peg-nik':          d.nik,
        'edit-peg-nip':          d.nip,
        'edit-peg-nama':         d.nama,
        'edit-peg-tempat-lahir': d.tempatLahir,
        'edit-peg-tgl-lahir':    d.tglLahir,
        'edit-peg-alamat':       d.alamat,
        'edit-peg-email':        d.email,
        'edit-peg-telp':         d.telp
      };
      Object.entries(fields).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el) el.value = val;
      });

      document.getElementById('editPegFotoName').textContent = 'Belum ada file dipilih';
      openModal('modal-edit-peg');
    }

    // Wire tombol Edit di setiap baris tabel pegawai
    document.querySelectorAll('#view-data-pegawai .btn-act-edit').forEach((btn, i) => {
      btn.addEventListener('click', () => openEditPegawai(i + 1));
    });

    // Modal controls
    document.getElementById('modal-edit-peg-close').addEventListener('click',  () => closeModal('modal-edit-peg'));
    document.getElementById('modal-edit-peg-batal').addEventListener('click',  () => closeModal('modal-edit-peg'));
    document.getElementById('modal-edit-peg-simpan').addEventListener('click', () => closeModal('modal-edit-peg'));
    document.getElementById('modal-edit-peg-hapus').addEventListener('click',  () => {
      closeModal('modal-edit-peg');
      // TODO: buka konfirmasi hapus
    });

    // Init CDDs
    initCdd(document.getElementById('cddUnitKerjaEdit'));
    initCdd(document.getElementById('cddJabatanEdit'));
    initCdd(document.getElementById('cddStatusPegEdit'));

    // File upload zone
    const editPegFotoInput = document.getElementById('edit-peg-foto-input');
    const editPegFotoZone  = document.getElementById('editPegFotoZone');
    const editPegFotoName  = document.getElementById('editPegFotoName');
    if (editPegFotoInput && editPegFotoZone) {
      editPegFotoInput.addEventListener('change', function() {
        editPegFotoName.textContent = this.files[0] ? this.files[0].name : 'Belum ada file dipilih';
      });
      editPegFotoZone.addEventListener('dragover', e => { e.preventDefault(); editPegFotoZone.classList.add('drag-over'); });
      editPegFotoZone.addEventListener('dragleave', () => editPegFotoZone.classList.remove('drag-over'));
      editPegFotoZone.addEventListener('drop', e => {
        e.preventDefault(); editPegFotoZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) { editPegFotoName.textContent = file.name; }
      });
    }

  </script>
</body>
</html>