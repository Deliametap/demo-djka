        </div>

        <!-- Tempat & Tanggal Lahir -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="edit-peg-tempat-lahir">Tempat Lahir <span class="req">*</span></label>
            <input class="form-input" id="edit-peg-tempat-lahir" type="text" placeholder="Isi tempat lahir..." autocomplete="off">
          </div>
