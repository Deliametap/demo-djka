  <!-- ══ MODAL: Tambah Pegawai ══════════════════════════════════ -->
  <div class="modal-overlay" id="modal-tambah-peg" role="dialog" aria-modal="true" aria-labelledby="modal-tambah-peg-title">
    <div class="modal modal-lg">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          </div>
          <span id="modal-tambah-peg-title">Tambah Pegawai</span>
        </div>
        <button class="modal-close" id="modal-tambah-peg-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="modal-body">

        <!-- ─ Section: Detail Pegawai ─ -->
        <div class="form-section-title">Detail Pegawai</div>

        <!-- Unit Kerja -->
        <div class="form-group">
          <label class="form-label">Unit Kerja <span class="req">*</span></label>
          <div class="cdd" id="cddUnitKerjaPeg" style="min-width:unset;">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value">Pilih unit kerja...</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox">
              <li class="cdd-item selected" role="option" data-value="">Pilih unit kerja...</li>
              <li class="cdd-item" role="option" data-value="bpp">Balai Pengujian Perkeretaapian</li>
              <li class="cdd-item" role="option" data-value="sktu">Subbagian Keuangan dan Tata Usaha</li>
              <li class="cdd-item" role="option" data-value="spra">Seksi Pengujian Prasarana</li>
              <li class="cdd-item" role="option" data-value="ssa">Seksi Pengujian Sarana</li>
              <li class="cdd-item" role="option" data-value="ssdm">Seksi Pengujian SDM</li>
            </ul>
          </div>
          <button class="quick-add-link" type="button" onclick="closeModal('modal-tambah-peg');openModal('modal-tambah-uk');">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Tambahkan unit kerja baru
          </button>
        </div>

        <!-- Sub Kantor -->
        <div class="form-group">
          <label class="form-label" for="peg-sub-kantor">Sub Kantor <span class="req">*</span></label>
          <input class="form-input" id="peg-sub-kantor" type="text" placeholder="Isi sub kantor..." autocomplete="off">
        </div>

        <!-- Jabatan -->
        <div class="form-group">
          <label class="form-label">Jabatan <span class="req">*</span></label>
          <div class="cdd" id="cddJabatanPeg" style="min-width:unset;">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value">Pilih jabatan...</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox">
              <li class="cdd-item selected" role="option" data-value="">Pilih jabatan...</li>
              <li class="cdd-item" role="option" data-value="kabpp">Kepala Balai Pengujian Perkeretaapian</li>
              <li class="cdd-item" role="option" data-value="kasktu">Kepala Subbagian Keuangan dan Tata Usaha</li>
              <li class="cdd-item" role="option" data-value="kaspra">Kepala Seksi Pengujian Prasarana</li>
              <li class="cdd-item" role="option" data-value="kassa">Kepala Seksi Pengujian Sarana</li>
              <li class="cdd-item" role="option" data-value="staff">Staff</li>
            </ul>
          </div>
          <button class="quick-add-link" type="button" onclick="closeModal('modal-tambah-peg');openModal('modal-tambah-jab');">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Tambahkan jabatan baru
          </button>
        </div>

        <!-- Jabatan Fungsional -->
        <div class="form-group">
          <label class="form-label" for="peg-jabfung">Jabatan Fungsional <span class="req">*</span></label>
          <input class="form-input" id="peg-jabfung" type="text" placeholder="Isi jabatan fungsional..." autocomplete="off">
        </div>

        <!-- Status Pegawai -->
        <div class="form-group">
          <label class="form-label">Status Pegawai <span class="req">*</span></label>
          <div class="cdd" id="cddStatusPegTambah" style="min-width:unset;">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value">Pilih status pegawai...</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox">
              <li class="cdd-item selected" role="option" data-value="">Pilih status pegawai...</li>
              <li class="cdd-item" role="option" data-value="ASN">ASN</li>
              <li class="cdd-item" role="option" data-value="P3K">P3K</li>
              <li class="cdd-item" role="option" data-value="PPNPN">PPNPN</li>
            </ul>
          </div>
        </div>

        <!-- ─ Section: Data Pribadi ─ -->
        <div class="form-section-title" style="margin-top:4px;">Data Pribadi</div>

        <!-- NIK & NIP side by side -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="peg-nik">NIK <span class="req">*</span></label>
            <input class="form-input" id="peg-nik" type="text" inputmode="numeric" placeholder="Isi NIK..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">510807XXXXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="peg-nip">NIP <span class="req">*</span></label>
            <input class="form-input" id="peg-nip" type="text" inputmode="numeric" placeholder="Isi NIP..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">510807XXXXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
        </div>

        <!-- Nama Pegawai -->
        <div class="form-group">
          <label class="form-label" for="peg-nama">Nama Pegawai <span class="req">*</span></label>
          <input class="form-input" id="peg-nama" type="text" placeholder="Isi nama pegawai..." autocomplete="off">
        </div>

        <!-- Tempat & Tanggal Lahir side by side -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="peg-tempat-lahir">Tempat Lahir <span class="req">*</span></label>
            <input class="form-input" id="peg-tempat-lahir" type="text" placeholder="Isi tempat lahir..." autocomplete="off">
          </div>
          <div class="form-group">
            <label class="form-label" for="peg-tgl-lahir">Tanggal Lahir <span class="req">*</span></label>
            <input class="form-input" id="peg-tgl-lahir" type="text" placeholder="DD/MM/YYYY" autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Input: <span class="form-hint-code">Tanggal/Bulan/Tahun</span></div>
            </div>
          </div>
        </div>

        <!-- Alamat -->
        <div class="form-group">
          <label class="form-label" for="peg-alamat">Alamat <span class="req">*</span></label>
          <textarea class="form-textarea" id="peg-alamat" placeholder="Isi alamat pegawai..."></textarea>
          <div class="form-hint">
            <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">-</span> Jika tidak ada</div>
          </div>
        </div>

        <!-- Email & No. Telepon side by side -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="peg-email">Email <span class="req">*</span></label>
            <input class="form-input" id="peg-email" type="email" placeholder="Isi email pegawai..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Contoh: <span class="form-hint-code">example@gmail.com</span></div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="peg-telp">No. Telepon <span class="req">*</span></label>
            <input class="form-input" id="peg-telp" type="text" inputmode="numeric" placeholder="Isi no. telepon..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">628215XXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
        </div>

        <!-- Foto Pegawai -->
        <div class="form-group">
          <label class="form-label">Foto Pegawai</label>
          <input type="file" id="peg-foto-input" accept=".jpg,.jpeg,.png" style="display:none;">
          <div class="file-upload-zone" id="pegFotoZone" onclick="document.getElementById('peg-foto-input').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            <span class="file-upload-text">Drag & drop file atau klik disini</span>
            <span class="file-upload-sub" id="pegFotoName">Belum ada file dipilih</span>
          </div>
          <div class="form-hint" style="margin-top:2px;">
            <div class="form-hint-row">*) Maksimal: <span class="form-hint-code amber">2MB</span> — Format: <span class="form-hint-code">*.jpg</span> <span class="form-hint-code">*.jpeg</span> <span class="form-hint-code">*.png</span></div>
          </div>
        </div>

      </div><!-- /.modal-body -->

      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-tambah-peg-batal">Batal</button>
        <button class="btn-modal-primary" id="modal-tambah-peg-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Simpan
        </button>
      </div>
    </div>
  </div>

