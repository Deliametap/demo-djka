    if (modalTambahBannerSimpan) modalTambahBannerSimpan.addEventListener('click', () => closeModal('modal-tambah-banner'));
    const cddBannerStatus = document.getElementById('cddBannerStatus');
    if (cddBannerStatus) initCdd(cddBannerStatus);

    /* ── Edit Banner ── */
    document.querySelectorAll('#view-mp-banner .btn-act-edit').forEach(btn => {
      btn.addEventListener('click', function() {
        document.getElementById('editBannerFotoName').textContent = 'Belum ada file dipilih';
        openModal('modal-edit-banner');
      });
    });
    document.getElementById('modal-edit-banner-close').addEventListener('click',  () => closeModal('modal-edit-banner'));
    document.getElementById('modal-edit-banner-batal').addEventListener('click',  () => closeModal('modal-edit-banner'));
    document.getElementById('modal-edit-banner-simpan').addEventListener('click', () => closeModal('modal-edit-banner'));
    initCdd(document.getElementById('cddEditBannerStatus'));

    const editBannerFotoInput = document.getElementById('edit-banner-foto-input');
    const editBannerFotoZone  = document.getElementById('editBannerFotoZone');
    const editBannerFotoName  = document.getElementById('editBannerFotoName');
    if (editBannerFotoInput && editBannerFotoZone) {
      editBannerFotoInput.addEventListener('change', function() {
        editBannerFotoName.textContent = this.files[0] ? this.files[0].name : 'Belum ada file dipilih';
      });
      editBannerFotoZone.addEventListener('dragover', e => { e.preventDefault(); editBannerFotoZone.classList.add('drag-over'); });
      editBannerFotoZone.addEventListener('dragleave', () => editBannerFotoZone.classList.remove('drag-over'));
      editBannerFotoZone.addEventListener('drop', e => {
        e.preventDefault(); editBannerFotoZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) { editBannerFotoName.textContent = file.name; }
      });
    }

    /* ── Hapus Banner ── */
    document.querySelectorAll('#view-mp-banner .btn-act[aria-label^="Hapus"]').forEach(btn => {
      btn.addEventListener('click', function() {
        openModal('modal-hapus-banner');
      });
    });
    document.getElementById('modal-hapus-banner-close').addEventListener('click',    () => closeModal('modal-hapus-banner'));
    document.getElementById('modal-hapus-banner-batal').addEventListener('click',    () => closeModal('modal-hapus-banner'));
    document.getElementById('modal-hapus-banner-konfirmasi').addEventListener('click', () => closeModal('modal-hapus-banner'));

    const bannerFotoInput = document.getElementById('banner-foto-input');
    const bannerFotoZone  = document.getElementById('bannerFotoZone');
    const bannerFotoName  = document.getElementById('bannerFotoName');
    if (bannerFotoInput && bannerFotoZone) {
      bannerFotoInput.addEventListener('change', function() {
        bannerFotoName.textContent = this.files[0] ? this.files[0].name : 'Belum ada file dipilih';
      });
      bannerFotoZone.addEventListener('dragover', e => { e.preventDefault(); bannerFotoZone.classList.add('drag-over'); });
      bannerFotoZone.addEventListener('dragleave', () => bannerFotoZone.classList.remove('drag-over'));
      bannerFotoZone.addEventListener('drop', e => {
        e.preventDefault(); bannerFotoZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) { bannerFotoName.textContent = file.name; }
      });
    }
  </script>

  </div><!-- /.app-shell -->

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Tambah Banner
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-tambah-banner" role="dialog" aria-modal="true" aria-labelledby="modal-tambah-banner-title">
    <div class="modal" style="width:520px;">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <span id="modal-tambah-banner-title">Tambah Banner</span>
        </div>
        <button class="modal-close" id="modal-tambah-banner-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body" style="gap:16px;">
        <div class="form-group">
          <label class="form-label">Gambar Banner <span class="req">*</span></label>
          <input type="file" id="banner-foto-input" accept=".jpg,.jpeg,.png,.webp" style="display:none;">
          <div class="file-upload-zone" id="bannerFotoZone" onclick="document.getElementById('banner-foto-input').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            <span class="file-upload-text">Drag & drop file atau klik disini</span>
            <span class="file-upload-sub" id="bannerFotoName">Belum ada file dipilih</span>
          </div>
          <div class="form-hint" style="margin-top:2px;">
            <div class="form-hint-row">*) Format: <span class="form-hint-code">*.jpg</span> <span class="form-hint-code">*.jpeg</span> <span class="form-hint-code">*.png</span> <span class="form-hint-code">*.webp</span> — Maksimal: <span class="form-hint-code amber">2MB</span></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-tambah-banner-batal">Batal</button>
        <button class="btn-modal-primary" id="modal-tambah-banner-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2.5;" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Simpan Data
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Edit Banner
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-edit-banner" role="dialog" aria-modal="true" aria-labelledby="modal-edit-banner-title">
    <div class="modal" style="width:520px;">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <span id="modal-edit-banner-title">Edit Banner</span>
        </div>
        <button class="modal-close" id="modal-edit-banner-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body" style="gap:16px;">
        <div class="form-group">
          <label class="form-label">Gambar Banner <span class="req">*</span></label>
          <input type="file" id="edit-banner-foto-input" accept=".jpg,.jpeg,.png,.webp" style="display:none;">
          <div class="file-upload-zone" id="editBannerFotoZone" onclick="document.getElementById('edit-banner-foto-input').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            <span class="file-upload-text">Drag & drop file atau klik disini</span>
            <span class="file-upload-sub" id="editBannerFotoName">Belum ada file dipilih</span>
          </div>
          <div class="form-hint" style="margin-top:2px;">
            <div class="form-hint-row">*) Format: <span class="form-hint-code">*.jpg</span> <span class="form-hint-code">*.jpeg</span> <span class="form-hint-code">*.png</span> <span class="form-hint-code">*.webp</span> — Maksimal: <span class="form-hint-code amber">2MB</span></div>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Status <span class="req">*</span></label>
          <div class="cdd" id="cddEditBannerStatus">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value selected">Aktif</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox" aria-label="Pilih status banner">
              <li class="cdd-item selected" role="option" data-value="aktif">Aktif</li>
              <li class="cdd-item" role="option" data-value="nonaktif">Tidak Aktif</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-edit-banner-batal">Batal</button>
        <button class="btn-modal-primary" id="modal-edit-banner-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2.5;" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Konfirmasi Hapus Banner
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-hapus-banner" role="dialog" aria-modal="true" aria-labelledby="modal-hapus-banner-title">
    <div class="modal" style="width:440px;">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon" style="background:var(--color-danger-bg);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-danger);" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </div>
          <span id="modal-hapus-banner-title">Hapus Banner?</span>
        </div>
        <button class="modal-close" id="modal-hapus-banner-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <p style="font-size:13.5px;color:var(--color-text-secondary);line-height:1.6;">
          Apakah Anda yakin ingin menghapus banner ini secara permanen? Tindakan ini <strong style="color:var(--color-danger);">tidak dapat dibatalkan</strong>.
        </p>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-hapus-banner-batal">Batalkan</button>
        <button class="btn-modal-primary" id="modal-hapus-banner-konfirmasi" style="background:var(--color-danger);border-color:var(--color-danger);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2;" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          Ya, Hapus
        </button>
      </div>
    </div>
  </div>

</body>
</html>
