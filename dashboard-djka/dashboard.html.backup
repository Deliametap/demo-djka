    function setCddValue(cddEl, value, label) {
      if (!cddEl) return;
      const trigger = cddEl.querySelector('.cdd-trigger');
      const valueEl = cddEl.querySelector('.cdd-value');
      const items   = cddEl.querySelectorAll('.cdd-item');
      if (valueEl) { valueEl.textContent = label; valueEl.classList.add('selected'); }
      if (trigger) trigger.dataset.selected = value;
      items.forEach(item => item.classList.toggle('selected', item.dataset.value === value));
    }

    function openEditPegawai(rowIndex) {
      const d = pegawaiData[rowIndex];
      if (!d) return;

      // Populate dropdowns
      setCddValue(document.getElementById('cddUnitKerjaEdit'), d.unitKerja, d.unitKerjaLabel);
      setCddValue(document.getElementById('cddJabatanEdit'),   d.jabatan,   d.jabatanLabel);
      setCddValue(document.getElementById('cddStatusPegEdit'), d.status,    d.status);

      // Populate text inputs
      const fields = {
        'edit-peg-sub-kantor':   d.subKantor,
        'edit-peg-jabfung':      d.jabfung,
        'edit-peg-nik':          d.nik,
        'edit-peg-nip':          d.nip,
        'edit-peg-nama':         d.nama,
        'edit-peg-tempat-lahir': d.tempatLahir,
        'edit-peg-tgl-lahir':    d.tglLahir,
        'edit-peg-alamat':       d.alamat,
        'edit-peg-email':        d.email,
        'edit-peg-telp':         d.telp
      };
      Object.entries(fields).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el) el.value = val;
      });

      document.getElementById('editPegFotoName').textContent = 'Belum ada file dipilih';
      openModal('modal-edit-peg');
    }

