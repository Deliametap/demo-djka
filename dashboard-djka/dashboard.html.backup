          const el = document.getElementById(id);
          if (!el) return;
          const valueEl = el.querySelector('.cdd-value');
          const items   = el.querySelectorAll('.cdd-item');
          const placeholder = items[0] ? items[0].textContent.trim() : '';
          if (valueEl) { valueEl.textContent = placeholder; valueEl.classList.remove('selected'); }
          items.forEach((item, i) => item.classList.toggle('selected', i === 0));
