  </div>

  <script>

    /* ── Chart ── */
    const labels = [
      'CEO Dashboard\nBalai Uji',
      'Hub Payment\nBLU',
      'Sistem Uji SDM\nPerkeretaapian',
      'Sarana\nPerkeretaapian',
      'Prasarana\nPerkeretaapian',
      'Koncore –\nSewa Aset BMN',
      'Portal\nBalai Uji'
    ];

    const data = [0, 0, 0, 0, 0, 0, 1];

    const colorFn = (ctx) => {
      const v = ctx.parsed ? ctx.parsed.y : data[ctx.dataIndex];
      return v > 0 ? '#1D4ED8' : '#CBD5E1';
    };

    new Chart(document.getElementById('loginChart'), {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Jumlah Login',
          data,
          backgroundColor: colorFn,
          borderRadius: 6,
          borderSkipped: false,
          minBarLength: 5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0F172A',
            titleColor: 'rgba(255,255,255,.55)',
            bodyColor: '#FFFFFF',
            titleFont: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '600' },
            bodyFont: { family: "'Plus Jakarta Sans', sans-serif", size: 13, weight: '600' },
            padding: 12,
            cornerRadius: 8,
            displayColors: false,
            callbacks: {
              title: items => items[0].label.replace(/\n/g, ' '),
              label: ctx => ` ${ctx.parsed.y} login`
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            border: { display: false },
            ticks: {
              font: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '500' },
              color: '#64748B',
              maxRotation: 0,
              minRotation: 0
            }
          },
          y: {
            grid: { color: '#F1F5F9' },
            border: { display: false, dash: [4, 4] },
            beginAtZero: true,
            ticks: {
              font: { family: "'Plus Jakarta Sans', sans-serif", size: 11 },
              color: '#94A3B8',
              stepSize: 1
            },
            title: {
              display: true,
              text: 'JUMLAH LOGIN',
              font: { family: "'Plus Jakarta Sans', sans-serif", size: 10, weight: '700' },
              color: '#94A3B8',
              padding: { bottom: 8 }
            }
          }
        }
      }
    });

  /* ── Update Date in Topbar ── */
  function updateCurrentDate() {
    const dateElement = document.getElementById('currentDate');
    if (dateElement) {
      const now = new Date();
      const bulanIndo = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      const hari = now.getDate();
      const bulan = bulanIndo[now.getMonth()];
      const tahun = now.getFullYear();
      dateElement.textContent = `${hari} ${bulan} ${tahun}`;
    }
  }
  updateCurrentDate();

  /* ── SDM Page Navigation ── */
  function showSDMPage(pageKey) {
    document.querySelectorAll('#subnav-sdm .subnav-item').forEach(t => {
      t.classList.toggle('active', t.dataset.page === pageKey);
    });
    document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
    const target = document.getElementById('view-' + pageKey);
    if (target) target.classList.add('active');
  }

  document.querySelectorAll('#subnav-sdm .subnav-item').forEach(item => {
    item.addEventListener('click', function() {
      showSDMPage(this.dataset.page);
    });
  });

  /* ── Sub-nav Panel Toggle ── */
  const subnavPanel = document.getElementById('subnavPanel');
  document.getElementById('subnavCollapse').addEventListener('click', function() {
    subnavPanel.classList.toggle('open');
  });

  /* ── Update topbar module icon ── */
  function updateTopbarIcon(navItem) {
    const svgSrc = navItem.querySelector('.nav-icon-box svg');
    const topbarSvg = document.getElementById('topbarModuleSvg');
    if (svgSrc && topbarSvg) {
      topbarSvg.innerHTML = svgSrc.innerHTML;
      topbarSvg.setAttribute('viewBox', svgSrc.getAttribute('viewBox') || '0 0 24 24');
    }
  }

  /* ── Sidebar Nav Clicks ── */
  function showMasterisasiPage(pageKey) {
    document.querySelectorAll('#subnav-masterisasi .subnav-item').forEach(t => {
      t.classList.toggle('active', t.dataset.page === pageKey);
    });
    document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
    const target = document.getElementById('view-' + pageKey);
    if (target) target.classList.add('active');
  }

  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelectorAll('.nav-item').forEach(n => {
        n.classList.remove('active');
        n.removeAttribute('aria-current');
      });
      this.classList.add('active');
      this.setAttribute('aria-current', 'page');
      updateTopbarIcon(this);

      const label = this.querySelector('.nav-item-label')?.textContent?.trim()
                 || this.getAttribute('aria-label') || '';
      const views = document.querySelectorAll('.page-view');

      document.querySelectorAll('.subnav-section').forEach(s => s.classList.remove('active'));

      if (label === 'SDM') {
        document.getElementById('subnav-sdm').classList.add('active');
        subnavPanel.classList.add('open');
        views.forEach(v => v.classList.remove('active'));
        showSDMPage('unit-kerja');
      } else if (label === 'Masterisasi') {
        document.getElementById('subnav-masterisasi').classList.add('active');
        subnavPanel.classList.add('open');
        views.forEach(v => v.classList.remove('active'));
        showMasterisasiPage('masterisasi-aplikasi');
      } else if (label === 'Akses SSO') {
        document.getElementById('subnav-akses-sso').classList.add('active');
        subnavPanel.classList.add('open');
        views.forEach(v => v.classList.remove('active'));
        document.getElementById('view-akses-sso').classList.add('active');
      } else if (label === 'Pengelola Portal') {
        document.getElementById('subnav-pengelola-portal').classList.add('active');
        subnavPanel.classList.add('open');
        views.forEach(v => v.classList.remove('active'));
        document.getElementById('view-pengelola-portal').classList.add('active');
      } else if (label === 'Data SIK') {
        document.getElementById('subnav-data-sik').classList.add('active');
        subnavPanel.classList.add('open');
        document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
        document.getElementById('view-sik-data-kantor').classList.add('active');
      } else if (label === 'API') {
        window.location.href = 'api.html';
      } else if (label === 'Manajemen Portal') {
        document.getElementById('subnav-manajemen-portal').classList.add('active');
        subnavPanel.classList.add('open');
        document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
        const mpView = document.getElementById('view-mp-banner');
        if (mpView) mpView.classList.add('active');
        else console.warn('view-mp-banner not found');
      } else {
        subnavPanel.classList.remove('open');
        views.forEach(v => v.classList.remove('active'));
        document.getElementById('view-dashboard').classList.add('active');
      }
    });
  });
  </script>

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Tambah Jabatan
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-tambah-jab" role="dialog" aria-modal="true" aria-labelledby="modal-tambah-jab-title">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <span id="modal-tambah-jab-title">Tambah Jabatan</span>
        </div>
        <button class="modal-close" id="modal-tambah-jab-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="input-nama-jab">Nama Jabatan <span class="req">*</span></label>
          <input class="form-input" id="input-nama-jab" type="text" placeholder="Isikan nama jabatan..." autocomplete="off">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-tambah-jab-batal">Batal</button>
        <button class="btn-modal-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Simpan Data
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Detail / Edit Jabatan
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-detail-jab" role="dialog" aria-modal="true" aria-labelledby="modal-detail-jab-title">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <span id="modal-detail-jab-title">Detail Jabatan</span>
        </div>
        <button class="modal-close" id="modal-detail-jab-close" aria-label="Tutup modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="edit-nama-jab">Nama Jabatan <span class="req">*</span></label>
          <input class="form-input" id="edit-nama-jab" type="text" placeholder="Isikan nama jabatan..." autocomplete="off">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-danger" id="modal-detail-jab-hapus">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          Hapus
        </button>
        <button class="btn-modal-ghost" id="modal-detail-jab-batal">Batal</button>
        <button class="btn-modal-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       MODAL: Tambah Unit Kerja
  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-tambah-uk" role="dialog" aria-modal="true" aria-labelledby="modal-tambah-uk-title">
    <div class="modal">
      <div class="modal-header">
