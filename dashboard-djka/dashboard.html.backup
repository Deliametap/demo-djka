        <button class="btn-modal-primary" id="modal-edit-portal-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2.5;" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <script>
    // ── Modal helpers ──────────────────────────────────────────
    function openModal(id) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.classList.add('open');
      const firstInput = overlay.querySelector('.form-input');
      if (firstInput) setTimeout(() => firstInput.focus(), 50);
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    // Close on overlay click
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', function(e) {
        if (e.target === this) closeModal(this.id);
      });
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.open').forEach(o => o.classList.remove('open'));
      }
    });

    // ── Tambah Unit Kerja ──────────────────────────────────────
    const btnTambahUK = document.querySelector('#view-unit-kerja .btn-tambah');
    if (btnTambahUK) {
      btnTambahUK.addEventListener('click', function() {
        document.getElementById('input-nama-uk').value = '';
        openModal('modal-tambah-uk');
      });
    }
    document.getElementById('modal-tambah-uk-close').addEventListener('click', () => closeModal('modal-tambah-uk'));
    document.getElementById('modal-tambah-uk-batal').addEventListener('click', () => closeModal('modal-tambah-uk'));

    // ── Detail Unit Kerja ──────────────────────────────────────
    document.querySelectorAll('#view-unit-kerja .btn-detail').forEach(btn => {
      btn.addEventListener('click', function() {
        const row = this.closest('tr');
        const nama = row ? row.cells[1].textContent.trim() : '';
        document.getElementById('edit-nama-uk').value = nama;
        openModal('modal-detail-uk');
      });
    });
    document.getElementById('modal-detail-uk-close').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-batal').addEventListener('click', () => closeModal('modal-detail-uk'));
    document.getElementById('modal-detail-uk-hapus').addEventListener('click', () => closeModal('modal-detail-uk'));

    // ── Custom Dropdown factory ────────────────────────────────
    function initCdd(cddEl) {
      const trigger = cddEl.querySelector('.cdd-trigger');
      const menu    = cddEl.querySelector('.cdd-menu');
      const valueEl = cddEl.querySelector('.cdd-value');
      const items   = cddEl.querySelectorAll('.cdd-item');
      let selected  = '';

      function open()  { trigger.classList.add('open'); menu.classList.add('open'); trigger.setAttribute('aria-expanded','true'); }
      function close() { trigger.classList.remove('open'); menu.classList.remove('open'); trigger.setAttribute('aria-expanded','false'); }
      function toggle(){ trigger.classList.contains('open') ? close() : open(); }

      trigger.addEventListener('click', e => { e.stopPropagation(); toggle(); });

      const placeholder = items[0] ? items[0].textContent.trim() : valueEl.textContent.trim();

      items.forEach(item => {
        item.addEventListener('click', () => {
          selected = item.dataset.value;
          items.forEach(i => i.classList.remove('selected'));
          item.classList.add('selected');
          valueEl.textContent = selected ? item.textContent.trim() : placeholder;
          valueEl.classList.toggle('selected', !!selected);
          close();
          cddEl.dispatchEvent(new CustomEvent('cdd:change', { detail: { value: selected } }));
        });
      });

      document.addEventListener('click', e => { if (!cddEl.contains(e.target)) close(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

      return { reset() { selected=''; items.forEach(i=>i.classList.remove('selected')); items[0].classList.add('selected'); valueEl.textContent=placeholder; valueEl.classList.remove('selected'); } };
    }

    // ── Filter popover toggle (Data Pegawai) ──────────────────
    const btnFilterPeg   = document.getElementById('btnFilterPegawai');
    const filterPopover  = document.getElementById('filterPopover');
    const cddPeg = initCdd(document.getElementById('cddStatusPegawai'));

    if (btnFilterPeg && filterPopover) {
      btnFilterPeg.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = filterPopover.classList.toggle('open');
        this.classList.toggle('active', isOpen);
        this.setAttribute('aria-expanded', isOpen);
      });
      document.addEventListener('click', function(e) {
        const wrap = document.getElementById('filterPopoverWrap');
        if (wrap && !wrap.contains(e.target)) {
          filterPopover.classList.remove('open');
          btnFilterPeg.classList.remove('active');
          btnFilterPeg.setAttribute('aria-expanded', 'false');
        }
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && filterPopover.classList.contains('open')) {
          filterPopover.classList.remove('open');
          btnFilterPeg.classList.remove('active');
          btnFilterPeg.setAttribute('aria-expanded', 'false');
          btnFilterPeg.focus();
        }
      });
      document.getElementById('btnResetFilterPegawai').addEventListener('click', () => cddPeg.reset());
      document.getElementById('btnApplyFilterPegawai').addEventListener('click', function() {
        filterPopover.classList.remove('open');
        btnFilterPeg.classList.remove('active');
        btnFilterPeg.setAttribute('aria-expanded', 'false');
      });
    }

    // ── Tambah Jabatan ─────────────────────────────────────────
    const btnTambahJab = document.querySelector('#view-jabatan .btn-tambah');
    if (btnTambahJab) {
      btnTambahJab.addEventListener('click', function() {
