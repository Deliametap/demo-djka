            <input class="form-input" id="edit-peg-tempat-lahir" type="text" placeholder="Isi tempat lahir..." autocomplete="off">
          </div>
          <div class="form-group">
            <label class="form-label" for="edit-peg-tgl-lahir">Tanggal Lahir <span class="req">*</span></label>
            <input class="form-input" id="edit-peg-tgl-lahir" type="text" placeholder="DD/MM/YYYY" autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Input: <span class="form-hint-code">Tanggal/Bulan/Tahun</span></div>
            </div>
          </div>
        </div>

        <!-- Alamat -->
        <div class="form-group">
          <label class="form-label" for="edit-peg-alamat">Alamat <span class="req">*</span></label>
          <textarea class="form-textarea" id="edit-peg-alamat" placeholder="Isi alamat pegawai..."></textarea>
          <div class="form-hint">
            <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">-</span> Jika tidak ada</div>
          </div>
        </div>

        <!-- Email & No. Telepon -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="edit-peg-email">Email <span class="req">*</span></label>
            <input class="form-input" id="edit-peg-email" type="email" placeholder="Isi email pegawai..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Contoh: <span class="form-hint-code">example@gmail.com</span></div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="edit-peg-telp">No. Telepon <span class="req">*</span></label>
            <input class="form-input" id="edit-peg-telp" type="text" inputmode="numeric" placeholder="Isi no. telepon..." autocomplete="off">
            <div class="form-hint">
              <div class="form-hint-row">*) Hanya angka: <span class="form-hint-code">628215XXXXXXXX</span></div>
              <div class="form-hint-row">*) Isi dengan: <span class="form-hint-code amber">0</span> Jika tidak ada</div>
            </div>
          </div>
        </div>

        <!-- Foto Pegawai -->
        <div class="form-group">
          <label class="form-label">Foto Pegawai</label>
          <input type="file" id="edit-peg-foto-input" accept=".jpg,.jpeg,.png" style="display:none;">
          <div class="file-upload-zone" id="editPegFotoZone" onclick="document.getElementById('edit-peg-foto-input').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            <span class="file-upload-text">Drag & drop file atau klik disini</span>
            <span class="file-upload-sub" id="editPegFotoName">Belum ada file dipilih</span>
          </div>
          <div class="form-hint" style="margin-top:2px;">
            <div class="form-hint-row">*) Maksimal: <span class="form-hint-code amber">2MB</span> — Format: <span class="form-hint-code">*.jpg</span> <span class="form-hint-code">*.jpeg</span> <span class="form-hint-code">*.png</span></div>
          </div>
        </div>

      </div><!-- /.modal-body -->

      <div class="modal-footer">
        <button class="btn-modal-danger" id="modal-edit-peg-hapus">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          Hapus Pegawai
