  ══════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modal-edit-sso" role="dialog" aria-modal="true" aria-labelledby="modal-edit-sso-title">
    <div class="modal" style="width:560px;">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-title-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <span id="modal-edit-sso-title">Form Edit Akses SSO</span>
        </div>
        <button class="btn-modal-ghost" id="modal-edit-sso-tutup" style="margin-left:auto;margin-right:0;border-radius:6px;padding:8px 14px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2.5;" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Tutup
        </button>
      </div>

      <div class="modal-body" style="gap:20px;">

        <!-- Pegawai -->
        <div class="form-group">
          <label class="form-label" for="sso-pegawai">Pegawai <span class="req">*</span></label>
          <div class="cdd" id="cddSsoPegawai">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value">Pilih pegawai...</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox" aria-label="Pilih pegawai">
              <li class="cdd-item" role="option" data-value="">Pilih pegawai...</li>
              <li class="cdd-item" role="option" data-value="ronald">RONALD JACKSON SIMBOLON, ST, MT</li>
              <li class="cdd-item" role="option" data-value="edwin">EDWIN DWI AHMAD, S.Kom.</li>
              <li class="cdd-item" role="option" data-value="donny">DONNY SUHARYONO, SE</li>
            </ul>
          </div>
        </div>

        <!-- Aplikasi -->
        <div class="form-group">
          <label class="form-label" for="sso-aplikasi">Aplikasi <span class="req">*</span></label>
          <div class="cdd" id="cddSsoAplikasi">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value selected">CEO DASHBOARD BALAI UJI</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox" aria-label="Pilih aplikasi">
              <li class="cdd-item selected" role="option" data-value="ceo-dashboard">CEO DASHBOARD BALAI UJI</li>
              <li class="cdd-item" role="option" data-value="hub-payment">HUB PAYMENT BLU</li>
              <li class="cdd-item" role="option" data-value="portal-permohonan">PORTAL PERMOHONAN PENGUJIAN</li>
            </ul>
          </div>
        </div>

        <!-- Level -->
        <div class="form-group">
          <label class="form-label" for="sso-level">Level <span class="req">*</span></label>
          <div class="cdd" id="cddSsoLevel">
            <button class="cdd-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-value selected">Administrator</span>
              <svg class="cdd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="cdd-menu" role="listbox" aria-label="Pilih level">
              <li class="cdd-item selected" role="option" data-value="administrator">Administrator</li>
              <li class="cdd-item" role="option" data-value="operator">Operator</li>
              <li class="cdd-item" role="option" data-value="viewer">Viewer</li>
            </ul>
          </div>
        </div>

        <!-- Status -->
        <div class="form-group">
          <label class="form-label">Status:</label>
          <div class="sso-status-select" id="ssoStatusSelect">
            <button class="sso-status-trigger status-aktif" type="button" id="ssoStatusTrigger" aria-haspopup="listbox" aria-expanded="false">
              <span class="status-left">
                <span class="sso-mini-toggle on" id="ssoMiniToggle" aria-hidden="true"></span>
                <span id="ssoStatusLabel">Aktif</span>
              </span>
              <svg class="status-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="sso-status-menu" id="ssoStatusMenu" role="listbox" aria-label="Pilih status">
              <li class="sso-status-option selected" role="option" data-value="aktif">
                <span class="opt-dot" style="background:var(--color-primary);"></span>
                Aktif
              </li>
              <li class="sso-status-option" role="option" data-value="nonaktif">
                <span class="opt-dot" style="background:var(--color-muted);"></span>
                Tidak Aktif
              </li>
            </ul>
          </div>
          <p class="sso-status-hint">*) Aktif= Bisa Digunakan; Tidak Aktif= Tidak Bisa Digunakan/Mati;</p>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn-modal-ghost" id="modal-edit-sso-batal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2;" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.65"/></svg>
          Batal
        </button>
        <button class="btn-modal-primary" id="modal-edit-sso-simpan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;stroke-width:2.5;" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Simpan
        </button>
      </div>
    </div>
  </div>

