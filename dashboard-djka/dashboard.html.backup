      2: { pegawai: 'edwin',  pegawaiLabel: 'EDWIN DWI AHMAD, S.Kom.',          aplikasi: 'ceo-dashboard', aplikasiLabel: 'CEO DASHBOARD BALAI UJI', level: 'administrator', levelLabel: 'Administrator', status: 'nonaktif' },
      3: { pegawai: 'donny',  pegawaiLabel: 'DONNY SUHARYONO, SE',              aplikasi: 'ceo-dashboard', aplikasiLabel: 'CEO DASHBOARD BALAI UJI', level: 'administrator', levelLabel: 'Administrator', status: 'aktif' },
    };

    function openEditSso(rowIndex) {
      const d = ssoData[rowIndex];
      if (!d) return;
      setCddValue(document.getElementById('cddSsoPegawai'),  d.pegawai,  d.pegawaiLabel);
      setCddValue(document.getElementById('cddSsoAplikasi'), d.aplikasi, d.aplikasiLabel);
      setCddValue(document.getElementById('cddSsoLevel'),    d.level,    d.levelLabel);
      setSsoStatus(d.status);
      openModal('modal-edit-sso');
    }

    function setSsoStatus(val) {
      const trigger   = document.getElementById('ssoStatusTrigger');
      const label     = document.getElementById('ssoStatusLabel');
      const miniToggle = document.getElementById('ssoMiniToggle');
      const options   = document.querySelectorAll('#ssoStatusMenu .sso-status-option');
      const isAktif   = val === 'aktif';

      trigger.className = 'sso-status-trigger ' + (isAktif ? 'status-aktif' : 'status-nonaktif');
      label.textContent = isAktif ? 'Aktif' : 'Tidak Aktif';
      miniToggle.className = 'sso-mini-toggle ' + (isAktif ? 'on' : 'off');
      options.forEach(o => o.classList.toggle('selected', o.dataset.value === val));
      trigger.dataset.value = val;
    }

    // Wire edit buttons in SSO table
    document.querySelectorAll('#view-akses-sso .btn-act-edit').forEach((btn, i) => {
      btn.addEventListener('click', () => openEditSso(i + 1));
    });

    // Status dropdown toggle
    const ssoStatusTrigger = document.getElementById('ssoStatusTrigger');
    const ssoStatusMenu    = document.getElementById('ssoStatusMenu');
    if (ssoStatusTrigger && ssoStatusMenu) {
      ssoStatusTrigger.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = ssoStatusMenu.classList.toggle('open');
        this.classList.toggle('open', isOpen);
        this.setAttribute('aria-expanded', isOpen);
      });
      ssoStatusMenu.querySelectorAll('.sso-status-option').forEach(opt => {
        opt.addEventListener('click', function() {
          setSsoStatus(this.dataset.value);
          ssoStatusMenu.classList.remove('open');
          ssoStatusTrigger.classList.remove('open');
          ssoStatusTrigger.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('click', function(e) {
        if (!document.getElementById('ssoStatusSelect').contains(e.target)) {
          ssoStatusMenu.classList.remove('open');
          ssoStatusTrigger.classList.remove('open');
          ssoStatusTrigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

